# =====================================================================
# TRACEWISE AI &mdash; Environment Configuration Template
# =====================================================================

# Server Port
PORT=5000

# Node Environment ('development' | 'production')
NODE_ENV=development

# Optional: MongoDB Atlas Database Connection
# If unset or empty, TRACEWISE operates in high-performance zero-cloud In-Memory / LocalStorage mode.
# MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.abcde.mongodb.net/tracewise?retryWrites=true&w=majority

# Client CORS Allowed Origin (Default '*' for hackathon evaluation)
CLIENT_ORIGIN=*

# Frontend API URL configuration (leave blank or specify when frontend is hosted separately from backend)
# VITE_API_URL=http://localhost:5000
